{
  "name": "@cobapen/markdown",
  "version": "0.8.3",
  "description": "A markdown converter for cobapen website",
  "keywords": [
    "markdown"
  ],
  "license": "MIT",
  "author": "yamavol",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "homepage": "https://github.com/cobapen/markdown#readme",
  "bugs": {
    "url": "https://github.com/cobapen/markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cobapen/markdown.git"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "engines": {
    "node": ">=20.11.0 <21 || >=21.2.0"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:dev": "tsc --build tsconfig.dev.json",
    "build:doc": "npm run build && node docs/build.js",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "dependencies": {
    "@cobapen/math": "^0.1.2",
    "@mathjax/src": "^4.1.3",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-adv-table": "^0.2.3",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "meaw": "^11.0.0"
  },
  "devDependencies": {
    "@cobapen/eslint-config": "^0.5.2",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "mustache": "^4.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
